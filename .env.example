# ---------------------------------------------------------------------------
# Newmark POS — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Neon Postgres. Two strings, and the difference matters:
#
#   DATABASE_URL           the POOLED one (host contains `-pooler`). This is
#                          what the running app uses, always. Vercel spins up
#                          many short-lived functions, and without the pooler
#                          they exhaust Postgres' connection limit under load —
#                          which fails on a busy Saturday, not in testing.
#   DIRECT_DATABASE_URL    the DIRECT one (no `-pooler`). Migrations only: a
#                          pooler cannot hold the lock `migrate deploy` takes.
#
# If you connected Neon through Vercel's Storage tab (native integration) with
# no custom prefix, it creates DATABASE_URL and DATABASE_URL_UNPOOLED for you —
# prisma.config.ts reads DATABASE_URL_UNPOOLED as the direct string
# automatically, so DIRECT_DATABASE_URL below is only needed if you set the
# connection strings by hand instead.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# A scratch Postgres database for `npm run test:integration`. WIPED on every
# run — never point this at the shop's database. A Neon branch is ideal.
TEST_DATABASE_URL=""

# 32+ character secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Keys the PIN lookup index, so a cashier's PIN can find its owner without
# testing every member of staff. Must be set before any PIN can be used, and
# must NOT change once staff have PINs — changing it makes every existing PIN
# unrecognisable until it is set again. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_PEPPER=""

# Identifies this physical till. Receipt numbers are prefixed with it so two
# offline terminals can never mint the same number.
TERMINAL_ID="T1"

# Central server this terminal syncs to. Leave blank for a single-till shop.
SYNC_ENDPOINT=""
SYNC_API_KEY=""

# --- Peripherals ------------------------------------------------------------
# manual | serial | network
SCALE_ADAPTER="manual"
SCALE_SERIAL_PATH="/dev/tty.usbserial"
SCALE_BAUD_RATE="9600"

# noop | network | usb
PRINTER_ADAPTER="noop"
PRINTER_HOST=""
PRINTER_PORT="9100"
PRINTER_WIDTH_MM="80"

# --- KRA eTIMS --------------------------------------------------------------
# noop | etims
TAX_AUTHORITY_ADAPTER="noop"
ETIMS_BASE_URL=""
ETIMS_KRA_PIN=""
ETIMS_BRANCH_ID=""
ETIMS_DEVICE_SERIAL=""

# --- M-Pesa (Daraja) --------------------------------------------------------
# manual | daraja
MPESA_ADAPTER="manual"
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_CALLBACK_URL=""
